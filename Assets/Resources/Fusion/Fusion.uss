/* Four Fusion: live controls over reusable arcade artwork. */
.fusion { flex-grow: 1; color: rgb(247,250,255); font-size: 18px; -unity-text-generator: advanced; --gold: rgb(255,212,51); --cyan: rgb(30,204,255); --muted: rgb(167,207,249); }
Label { white-space: normal; -unity-text-align: middle-left; }
.menu-background { background-color: rgb(2,9,34); }
.screen-backdrop { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-background-scale-mode: scale-and-crop; }
.safe { flex-grow: 1; align-items: center; min-height: 0; }
.content { width: 100%; max-width: 540px; flex-grow: 1; min-height: 0; transition-property: opacity, translate; transition-duration: .18s; }
.screen-scroll { flex-grow: 1; min-height: 0; }
.screen-scroll .unity-scroll-view__content-container { padding: 0 3px 12px 3px; }
.unity-scroller--vertical { width: 4px; min-width: 4px; max-width: 4px; margin-left: 2px; }
.unity-scroll-view__vertical-scroller { overflow: hidden; }
.unity-scroll-view__vertical-scroller .unity-base-slider__tracker { width: 4px; min-width: 4px; max-width: 4px; left: 0; right: auto; }
.unity-scroll-view__vertical-scroller .unity-base-slider__dragger { width: 4px; min-width: 4px; max-width: 4px; }
.unity-scroll-view__vertical-scroller .unity-slider { min-width: 4px; margin: 0; }
.unity-scroller--vertical .unity-scroller__low-button, .unity-scroller--vertical .unity-scroller__high-button { display: none; }
.unity-scroller--vertical .unity-base-slider__tracker { background-color: rgba(103,163,227,.25); border-radius: 8px; }
.unity-scroller--vertical .unity-base-slider__dragger { background-color: rgb(78,167,255); border-radius: 8px; }
.row { flex-direction: row; }
.surface { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.brand { align-items: center; flex-shrink: 0; margin: 0; }
.brand-image { width: 100%; max-width: 290px; height: 140px; -unity-background-scale-mode: scale-to-fit; }
.hero .brand-image { max-width: 360px; height: 176px; }
.hero { margin-top: 12px; }
.tagline { -unity-text-align: middle-center; -unity-font-style: bold; font-size: 15px; color: rgb(230,241,255); margin: 0 0 4px 0; }
.home-illustration { height: 236px; width: 100%; -unity-background-scale-mode: scale-to-fit; margin: 0 0 6px 0; }
.home-actions { width: 88%; align-self: center; }
.home-actions .action { min-height: 67px; margin-bottom: 8px; }
.home-actions .action-label { font-size: 25px; }
.home-actions .icon { width: 29px; height: 29px; margin-right: 15px; }
.home-links { align-items: center; }
.home-links .quiet { min-height: 30px; padding: 2px 10px; margin: 0; }
.home-links .action-label { font-size: 13px; }
.footer { font-size: 11px; letter-spacing: 1px; color: rgb(131,167,215); -unity-text-align: middle-center; margin: 4px 0 0 0; }
.menu-top { min-height: 140px; justify-content: center; }
.menu-top .brand { align-self: flex-end; width: 73%; }
.menu-top .brand-image { height: 138px; }
.menu-top .back { position: absolute; left: 0; top: 45px; min-width: 84px; min-height: 44px; margin: 0; padding: 9px 13px; }
.menu-top .back .action-label { font-size: 14px; }
.menu-top .back .icon { width: 17px; height: 17px; margin-right: 6px; }
.brand-marks { justify-content: center; margin: 6px 0 14px 0; }
.dot { width: 14px; height: 14px; border-radius: 50%; margin: 0 4px; -unity-background-scale-mode: scale-to-fit; }
.coral { background-color: rgb(255,52,86); }
.gold { background-color: var(--gold); }
.blue { background-color: var(--cyan); }
.heading { font-size: 28px; -unity-font-style: bold; -unity-text-align: middle-center; margin: 5px 6px 8px 6px; }
.heading-rule { flex-direction: row; width: 112px; height: 2px; align-self: center; margin: 0 0 18px 0; }
.rule-gold { width: 50%; background-color: var(--gold); }
.rule-blue { width: 50%; background-color: var(--cyan); }
.action { position: relative; flex-direction: row; align-items: center; justify-content: center; margin: 0 0 8px 0; padding: 15px 20px; min-height: 60px; border-width: 0; border-radius: 24px; background-image: none; background-color: rgba(0,0,0,0); color: rgb(247,250,255); white-space: normal; transition-property: scale, opacity; transition-duration: .1s; }
.action:hover { background-color: rgba(0,0,0,0); scale: 1.015 1.015; }
.action:active { scale: 0.975 0.975; }
.action:focus { border-width: 1px; border-color: rgb(255,236,159); }
.action:disabled { opacity: .42; scale: 1 1; }
.action-label { flex-shrink: 1; -unity-text-align: middle-center; -unity-font-style: bold; font-size: 18px; padding: 0; margin: 0; }
.icon { width: 24px; height: 24px; flex-shrink: 0; margin-right: 10px; }
.primary .action-label, .rematch .action-label { color: rgb(58,27,0); font-size: 21px; }
.home-actions .primary .action-label { font-size: 25px; }
.quiet { color: var(--muted); min-height: 42px; padding: 8px; }
.quiet .action-label { -unity-font-style: normal; }
.card { min-height: 206px; margin-bottom: 12px; padding: 22px; align-items: flex-start; justify-content: center; flex-direction: column; }
.card-art { position: absolute; right: 7px; bottom: 8px; width: 48%; height: 92%; -unity-background-scale-mode: scale-to-fit; }
.card-copy { width: 52%; min-width: 0; }
.card-mark { align-self: flex-start; font-size: 20px; -unity-font-style: bold; color: var(--gold); -unity-text-align: middle-center; min-width: 41px; padding: 4px; border-radius: 12px; border-width: 1px; border-color: rgb(221,150,29); background-color: rgba(3,10,28,.6); margin-bottom: 9px; }
.card-title { font-size: 23px; -unity-font-style: bold; margin-bottom: 8px; }
.muted { font-size: 16px; color: var(--muted); }
.card .muted { font-size: 14px; max-width: 100%; white-space: normal; }
.card-arrow { position: absolute; right: 13px; bottom: 13px; width: 48px; height: 48px; align-items: center; justify-content: center; }
.card-arrow .icon { width: 21px; height: 21px; margin: 0; }
.view-difficulty .menu-top { min-height: 118px; }
.view-difficulty .menu-top .brand-image { height: 116px; }
.view-difficulty .heading-rule { margin-bottom: 12px; }
.difficulty-card { min-height: 114px; padding: 12px 22px; margin-bottom: 8px; }
.difficulty-card .card-art { width: 45%; height: 100%; bottom: 0; right: 12px; }
.difficulty-card .card-title { font-size: 23px; margin: 0 0 3px 0; }
.difficulty-card .muted { font-size: 13px; }
.difficulty-card .card-arrow { width: 40px; height: 40px; bottom: 10px; right: 12px; }
.rating { margin-top: 6px; }
.rating .icon { width: 20px; height: 20px; margin-right: 4px; }
.selection-label { font-size: 10px; color: var(--gold); -unity-font-style: bold; position: absolute; bottom: 1px; left: 76px; }
.selection-check { position: absolute; right: 13px; top: 12px; width: 21px; height: 21px; border-radius: 50%; background-color: var(--gold); align-items: center; justify-content: center; }
.selection-check .icon { width: 14px; height: 14px; margin: 0; }
.section-heading { flex-direction: row; align-items: center; margin: 14px 9px 7px 9px; }
.section-heading .icon { width: 23px; height: 23px; margin-right: 10px; }
.section-title { font-size: 19px; color: var(--gold); -unity-font-style: bold; }
.settings-card { padding: 12px 20px; margin-bottom: 4px; }
.setting-toggle { min-height: 47px; flex-direction: row; font-size: 17px; margin-left: 0; margin-right: 0; }
.setting-toggle .unity-toggle__label { min-width: 0; flex-grow: 1; flex-shrink: 1; white-space: normal; -unity-font-style: bold; }
.setting-toggle .unity-toggle__input { margin-left: 10px; flex-grow: 0; flex-shrink: 0; width: 49px; min-width: 49px; }
.setting-toggle .unity-toggle__checkmark { width: 49px; height: 28px; margin: 0; background-image: none; background-color: rgb(31,70,132); border-radius: 20px; border-width: 1px; border-color: rgb(62,129,205); }
.setting-toggle:checked .unity-toggle__checkmark { background-image: none; background-color: rgb(255,59,94); border-color: rgb(255,115,140); }
.switch-thumb { position: absolute; left: 2px; top: 2px; width: 22px; height: 22px; border-radius: 20px; background-color: rgb(242,252,255); border-width: 1px; border-color: white; transition-property: left; transition-duration: .12s; }
.setting-toggle:checked .switch-thumb { left: 23px; }
.setting-label { font-size: 16px; margin-top: 5px; -unity-font-style: bold; }
.volume { min-height: 40px; margin: 0 4px 0 0; }
.volume .unity-base-slider__tracker { height: 7px; border-radius: 10px; border-width: 1px; border-color: rgb(55,115,197); background-color: rgb(17,58,119); }
.volume .unity-base-slider__dragger { width: 25px; height: 25px; margin-top: -9px; border-radius: 20px; border-width: 2px; border-color: rgb(255,145,162); background-color: rgb(255,60,96); }
.language-grid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.language { width: 49%; min-height: 52px; padding: 10px 28px 10px 12px; margin-bottom: 5px; }
.language .action-label { font-size: 17px; -unity-font-style: normal; }
.language .selection-check { top: 17px; right: 11px; width: 18px; height: 18px; }
.theme { width: 49%; margin-right: 1%; flex-direction: column; min-height: 100px; padding: 14px 9px 10px 9px; }
.swatches { justify-content: center; margin: 0 0 5px 0; }
.swatches .dot { width: 44px; height: 44px; margin: 0 3px; }
.theme .player-name { font-size: 14px; }
.theme .selection-check { top: 11px; right: 10px; width: 18px; height: 18px; }
.information { min-height: 53px; justify-content: flex-start; padding: 12px 21px; margin-bottom: 5px; }
.information .action-label { font-size: 16px; -unity-font-style: normal; -unity-text-align: middle-left; }
.information .icon { width: 21px; height: 21px; }
.info-panel { padding: 24px; }
.body { font-size: 18px; margin-bottom: 18px; color: rgb(220,237,255); }
.game-header { flex-shrink: 0; }
.game-header .brand-image { height: 102px; max-width: 230px; }
.players { justify-content: space-between; margin: 4px 0 0 0; }
.player-card { width: 49%; min-height: 52px; padding: 9px; flex-direction: row; align-items: center; justify-content: center; }
.player-disc { width: 33px; height: 33px; margin-right: 8px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; }
.disc-number { display: none; }
.player-name { font-size: 16px; -unity-font-style: bold; -unity-text-align: middle-center; flex-shrink: 1; }
.turn { color: var(--gold); font-size: 23px; -unity-font-style: bold; -unity-text-align: middle-center; margin: 8px 0 0 0; }
.difficulty-badge { align-self: center; color: var(--muted); font-size: 12px; margin: 1px 0 0 0; }
.board-stage { flex-grow: 1; min-height: 190px; margin: 3px 0 2px 0; }
.board-frame { position: absolute; }
.column-targets { position: absolute; flex-direction: row; }
.column-target { flex-grow: 1; width: 14.2857%; height: 100%; margin: 0; padding: 0; border-width: 0; border-radius: 14px; background-image: none; background-color: rgba(0,0,0,0); }
.column-target:hover, .column-target:active, .column-target:focus { background-color: rgba(12,190,255,.12); }
.column-target:disabled { background-color: rgba(0,0,0,0); opacity: 1; }
.column-cue { position: absolute; left: 22%; top: -19px; width: 56%; height: 8px; border-width: 2px; border-color: var(--cyan); border-radius: 50%; background-color: rgba(0,81,207,.2); }
.column-target:hover .column-cue, .column-target:focus .column-cue { border-color: var(--gold); background-color: rgba(255,180,0,.25); }
.column-target:disabled .column-cue { opacity: .35; }
.game-footer { flex-shrink: 0; }
.hint { font-size: 15px; -unity-font-style: bold; -unity-text-align: middle-center; margin: 0 0 6px 0; }
.undo-count { font-size: 12px; color: var(--muted); -unity-text-align: middle-center; margin-bottom: 4px; }
.undo { min-height: 56px; margin-bottom: 5px; }
.undo .action-label { font-size: 20px; }
.compact-action { flex-grow: 1; flex-basis: 0; min-width: 0; padding: 10px 6px; margin: 0 1px; min-height: 56px; }
.compact-action .action-label { font-size: 13px; }
.compact-action .icon { width: 18px; height: 18px; margin-right: 5px; }
.overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(0,4,22,.72); justify-content: center; align-items: center; }
.modal-scroll { max-height: 100%; width: 100%; max-width: 420px; flex-grow: 0; }
.modal { padding: 20px 22px 14px 22px; transition-property: opacity, translate; transition-duration: .18s; }
.modal .brand-image { height: 106px; max-width: 230px; }
.modal .heading { color: var(--gold); font-size: 28px; margin: 10px 0 20px 0; }
.modal .muted { -unity-text-align: middle-center; font-size: 16px; margin: 0 0 15px 0; }
.modal .action { min-height: 59px; }
.modal .quiet { min-height: 38px; margin: 2px 0 0 0; }
.result-modal .brand-image { height: 138px; max-width: 290px; }
.result-modal .heading { font-size: 29px; margin: 6px 0 15px 0; }
.result-mark { justify-content: center; margin: 0 0 18px 0; padding: 10px 0; }
.result-burst { position: absolute; left: 0; right: 0; top: -18px; bottom: -18px; }
.coin-crack { position: absolute; left: 0; top: 0; width: 100%; height: 100%; margin: 0; }
.result-mark .dot { width: 46px; height: 46px; margin: 0 2px; }
.result-lose .heading { color: rgb(255,104,119); }
.result-draw .heading { color: var(--cyan); }
.toast { position: absolute; left: 22px; right: 22px; bottom: 80px; padding: 16px; border-radius: 18px; border-width: 1px; border-color: var(--gold); background-color: rgb(5,23,65); color: white; -unity-text-align: middle-center; font-size: 16px; }
.enter { opacity: 0; translate: 0 10px; }
.rtl Label { -unity-text-align: middle-right; }
.rtl .row, .rtl .section-heading, .rtl .action, .rtl .player-card, .rtl .setting-toggle { flex-direction: row-reverse; }
.rtl .card { flex-direction: column; align-items: flex-end; }
.rtl .theme { flex-direction: column; }
.rtl .card-art { right: auto; left: 7px; }
.rtl .card-arrow { right: auto; left: 13px; }
.rtl .card-mark { align-self: flex-end; }
.rtl .menu-top .brand { align-self: flex-start; }
.rtl .menu-top .back { left: auto; right: 0; }
.rtl .player-disc { margin-right: 0; margin-left: 8px; }
.rtl .icon { margin-right: 0; margin-left: 10px; }
.rtl .selection-check .icon, .rtl .card-arrow .icon { margin: 0; }
.rtl .heading, .rtl .turn, .rtl .tagline, .rtl .player-name, .rtl .hint, .rtl .undo-count, .rtl .action-label, .rtl .footer, .rtl .modal .muted { -unity-text-align: middle-center; }
.compact .hero { margin-top: 4px; }
.compact .hero .brand-image { height: 139px; }
.compact .home-illustration { height: 197px; }
.compact .home-actions .action { min-height: 59px; }
.compact .menu-top { min-height: 114px; }
.compact .menu-top .brand-image { height: 112px; }
.compact .menu-top .back { top: 35px; }
.compact .card { min-height: 180px; padding: 20px; }
.compact .difficulty-card { min-height: 104px; padding: 10px 20px; }
.compact.view-difficulty .menu-top { min-height: 100px; }
.compact.view-difficulty .menu-top .brand-image { height: 98px; }
.compact.view-difficulty .heading { font-size: 25px; }
.compact .game-header .brand-image { height: 76px; }
.compact .turn { font-size: 21px; margin-top: 5px; }
.compact .modal .brand-image { height: 85px; }
.compact .result-modal .brand-image { height: 113px; }
.landscape .content { max-width: none; }
.landscape .screen-scroll .unity-scroll-view__content-container { width: 620px; align-self: center; }
.landscape.view-home .screen-scroll .unity-scroll-view__content-container { width: 100%; flex-direction: row; flex-wrap: wrap; align-items: center; }
.landscape .home-showcase { width: 54%; }
.landscape .home-actions { width: 40%; margin-left: 3%; }
.landscape .home-links { width: 100%; }
.landscape .hero .brand-image { height: 95px; }
.landscape .home-illustration { height: 190px; }
.landscape .game-header { width: 26%; }
.landscape .players { flex-direction: column; }
.landscape .player-card { width: 100%; margin-bottom: 7px; }
.landscape .board-stage { position: absolute; left: 28%; right: 28%; top: 0; bottom: 0; }
.landscape .game-footer { position: absolute; right: 0; width: 26%; top: 35px; }
.landscape .game-footer .row { flex-direction: column; }
.landscape .compact-action { flex-basis: auto; margin-bottom: 4px; min-height: 48px; }
